<?xml version="1.0" encoding="utf-8"?>
<!--
  adaptive icon 的前景层：白色 ¥ 字徽。背景层是纯色 @color/icon_bg（见 mipmap-anydpi-v26）。

  viewport 沿用 512，坐标与 miniapp/public/icons/icon.svg 中的字徽完全一致，改图时两边好对照。
  外层 group 以画布中心为轴缩到 0.9：adaptive icon 的安全区是中心直径 72dp（在 512 viewport 下
  半径 170.7），原字徽包围盒的角点距中心约 166.2，虽然勉强在内但余量太小，缩到 0.9 后约 149.6，
  各厂商形状（圆形/水滴/方形）裁切都不会切到字。

  用 vector 而非 PNG：矢量任意密度都清晰，体积极小，也省掉前景层必须透明这个易错点。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.9"
        android:scaleY="0.9">

        <!-- 左斜画 -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M150,132 L196,132 L268,236 L240,268 Z" />
        <!-- 右斜画 -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M362,132 L316,132 L244,236 L272,268 Z" />
        <!-- 竖干 -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M236,238 L276,238 L276,384 L236,384 Z" />
        <!-- 上横 -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M164,268 L348,268 L348,304 L164,304 Z" />
        <!-- 下横 -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M164,330 L348,330 L348,366 L164,366 Z" />
    </group>
</vector>
