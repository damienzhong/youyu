<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      无 ActionBar 的浅色主题。状态栏取品牌绿 #12a150，与首页 hero 的绿色渐变衔接
      （与 PWA 的 theme_color 保持一致）。
      刻意不做沉浸式状态栏：各页顶部内边距依赖 uni.getSystemInfoSync().statusBarHeight，
      该值在 H5 端为 0，内容延伸到状态栏下会被压住。
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/page_bg</item>
    </style>
</resources>
