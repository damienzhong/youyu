# OS
.DS_Store

# Environment / secrets（绝不提交）
.env
*.local
application-local.yml
# 部署环境变量（含密码/密钥）；只提交 env.conf.example
deploy/env.conf
env.conf
# 本地连服务器数据库的配置（含服务器 IP / DB 口令）；只提交 .example
deploy/dev-remote-db.conf

# Java / Maven
target/
*.iml
.idea/
.mvn/wrapper/maven-wrapper.jar

# Logs / runtime
logs/
*.log

# jqwik 属性测试运行数据库
.jqwik-database

# Node / 前端（后续任务 1.2 引入）
node_modules/
dist/
.vite/

# 例外：小程序发布产物随代码提交（另一台机器拉取后可直接上传发布小程序）。
# 根级 dist/ 会排除整个 miniapp/dist，需先逐级打开父目录链，才能放行 mp-weixin；
# H5 网页产物仍被 miniapp/.gitignore 的 dist/build/* 忽略、不纳入版本库。
!miniapp/dist/
!miniapp/dist/build/
!miniapp/dist/build/mp-weixin/
!miniapp/dist/build/mp-weixin/**
