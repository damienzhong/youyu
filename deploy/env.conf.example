# ============================================================
# 有余(youyu) 生产环境变量模板
# 复制为 /opt/youyu/app/env.conf 并改为真实值；chmod 600，切勿提交到仓库。
# 对应 application.yml 中的 ${YOUYU_*} 占位。
# ============================================================

# 服务监听端口（nginx 反代到此端口；与 lodestar 的 8080 错开）
YOUYU_PORT=8090

# MySQL 数据源（库需为 utf8mb4；Flyway 启动时自动建表/迁移）
YOUYU_DB_URL=jdbc:mysql://127.0.0.1:3306/youyu?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
YOUYU_DB_USER=youyu
YOUYU_DB_PASSWORD=改成强密码

# JWT 签名密钥：务必用长随机串覆盖！生成：openssl rand -base64 48
YOUYU_JWT_SECRET=用 openssl rand -base64 48 生成一个长随机串

# 令牌有效期（毫秒），默认 7 天
YOUYU_JWT_EXPIRATION_MS=604800000

# 登录失败锁定策略
YOUYU_AUTH_MAX_FAILED=5
YOUYU_AUTH_LOCK_MINUTES=15

# 微信小程序登录：从微信公众平台「开发管理-开发设置」获取，切勿提交明文到仓库
YOUYU_WX_APPID=你的小程序 AppID
YOUYU_WX_SECRET=你的小程序 AppSecret
# 截图记账（视觉大模型，阿里云百炼 OpenAI 兼容接口；与 lodestar 共用同一个百炼账号的 API Key）
# 留空即关闭截图识别，其它功能不受影响。模型名须是该账号可用的视觉模型。
YOUYU_VISION_API_KEY=
YOUYU_VISION_MODEL=qwen3.8-flash
# 每人每天免费识别张数（识别失败 / 不是账单的图不计）
YOUYU_VISION_DAILY_LIMIT=10
