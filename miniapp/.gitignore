node_modules/
# 构建产物默认不入库，但保留可直接上传的微信小程序生产包
# （供另一台机器 git pull 后用微信开发者工具打开直接上传发布）。
dist/*
!dist/build/
dist/build/*
!dist/build/mp-weixin/
unpackage/
# 微信开发者工具的本地私有配置（libVersion、本地调试开关等），
# 每次用工具打开或重新构建都会变，属个人环境配置，不入库。
dist/build/mp-weixin/project.private.config.json
.env
.env.local
*.log
.DS_Store

# 微信代码上传私钥与预览产物，切勿提交
.keys/
*.key
preview-qr.png

# 本地自带的 Node 运行时（供 miniprogram-ci 在旧版 Node 下运行）
.node/
